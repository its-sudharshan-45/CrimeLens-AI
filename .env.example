# CrimeLens AI — root environment template
# Copy to .env (repo root), backend/.env, and frontend/.env as needed.
# Never commit files containing real credentials.

# ── Backend (also copy relevant vars to backend/.env) ──────────────────────────
ENVIRONMENT=development
PROJECT_NAME="CrimeLens AI"
API_V1_STR="/api/v1"

DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_VERIFICATION_METHOD=jwks
SUPABASE_JWKS_URL=

STORAGE_BUCKET_NAME=evidence
MAX_UPLOAD_SIZE_BYTES=52428800
EVIDENCE_UPLOAD_PATH=evidence
SIGNED_URL_EXPIRATION_SECONDS=3600

AI_MODELS_DIR=ai/models
AI_REGISTRY_DIR=ai/registry
AI_REGISTRY_INDEX=ai/registry/registry_index.json
AI_ACTIVE_VERSION_FILE=ai/registry/active_version.json
AI_TRAINING_STATISTICS=ai/models/training_statistics.json

LOG_DIR=logs
HOST=0.0.0.0
PORT=8000

# ── Frontend (copy to frontend/.env) ───────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SITE_URL=http://localhost:5173
